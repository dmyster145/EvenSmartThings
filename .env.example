SMARTTHINGS_CONTROLS_PUBLIC_APP_URL=http://127.0.0.1:5173
SMARTTHINGS_CONTROLS_API_ORIGIN=http://127.0.0.1:8787
SMARTTHINGS_CONTROLS_SERVER_HOST=127.0.0.1
SMARTTHINGS_CONTROLS_SERVER_PORT=8787
SMARTTHINGS_CONTROLS_STORAGE_PREFIX=smartthings-controls
SMARTTHINGS_CONTROLS_SESSION_TTL_SECONDS=2592000
SMARTTHINGS_CONTROLS_OAUTH_STATE_TTL_SECONDS=600
SMARTTHINGS_CLIENT_ID=replace-with-smartthings-client-id
SMARTTHINGS_CLIENT_SECRET=replace-with-smartthings-client-secret
SMARTTHINGS_SCOPES=r:devices:* x:devices:* r:locations:* r:scenes:* x:scenes:*
SMARTTHINGS_REDIRECT_URI=http://127.0.0.1:5173/api/auth/smartthings/callback

# Production Vercel/Upstash Redis storage.
# Set either the KV_* variables injected by Vercel Marketplace Redis
# or the UPSTASH_REDIS_REST_* variables from Upstash directly.
# KV_REST_API_URL=https://<your-upstash-endpoint>.upstash.io
# KV_REST_API_TOKEN=replace-with-upstash-token
# UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# SMARTTHINGS_DB_REDIS_URL=redis://default:<password>@<host>:<port>
