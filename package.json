{
  "name": "smartthings-controls",
  "version": "2.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,green \"npm run dev:server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "prebuild": "node scripts/sync-app-version.mjs",
    "fetch:voice-model": "node scripts/fetch-vosk-model.cjs",
    "build": "tsc -b && vite build",
    "pack": "npm run build && npx @evenrealities/evenhub-cli@0.1.13 pack app.json dist/ && mv out.ehpk smartthings-controls.ehpk",
    "preview": "vite preview",
    "lint": "eslint src/ server/ api/",
    "test": "vitest run",
    "test:unit": "vitest run src/lifecycle/resume-scheduler.test.ts src/render/composer.test.ts src/devices/normalize.test.ts src/voice/config.test.ts src/voice/grammar.test.ts",
    "test:smoke": "vitest run -t \"@smoke\"",
    "test:e2e": "vitest run src/lifecycle/resume-lifecycle.e2e.test.ts src/voice/config-lifecycle.e2e.test.ts src/voice/voice-config-route.e2e.test.ts",
    "test:regression": "vitest run -t \"@regression\"",
    "version": "node scripts/sync-app-version.mjs && git add app.json"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "@smartthings/core-sdk": "^4.0.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "even-toolkit": "^1.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "redis": "^5.12.1",
    "tailwind-merge": "^3.6.0",
    "util": "^0.12.5",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.6"
  }
}
